{
  "extends": "./tsconfig.json",
  // Narrow the inherited include: tsconfig.json adds vitest.config.ts for
  // editor support, but it sits outside rootDir and would break the emit.
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts"],
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "declarationMap": false
  }
}
