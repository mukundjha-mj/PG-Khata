{
  "name": "@pgkhata/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "openapi:generate": "tsx src/openapi/write.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@better-auth/cli": "1.3.7",
    "@pgkhata/config": "workspace:*",
    "@pgkhata/contracts": "workspace:*",
    "@pgkhata/db": "workspace:*",
    "better-auth": "1.3.7",
    "cors": "2.8.5",
    "drizzle-orm": "0.44.5",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "helmet": "8.1.0",
    "pino": "9.6.0",
    "pino-http": "10.5.0",
    "postgres": "3.4.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "22.16.5",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "3.2.4",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
