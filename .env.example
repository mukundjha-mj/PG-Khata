# Copy to .env and fill in. Never commit .env itself.

# --- Hostnames ---
# Marketing and the owner app are one build served on two hostnames, so links
# that cross between them must be absolute: a session cookie set on the
# marketing host is not sent to the app host.
#
#   www.pgkhata.com    marketing, blog, sitemap — the only indexable host
#   app.pgkhata.com    the owner app
#   admin.pgkhata.com  internal console
#
# robots.txt is served per host: app.* and admin.* answer `Disallow: /`.
#
# Leave VITE_APP_URL empty in development and preview builds — app links then
# stay same-origin and localhost keeps working.
VITE_SITE_URL=https://www.pgkhata.com
VITE_APP_URL=

# --- Supabase ---
# Browser-visible. The publishable key is safe to expose; RLS is the boundary.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Server only. Bypasses RLS entirely — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
# Reminders and bill emails are skipped, not failed, when this is absent.
#
# Send transactional and marketing mail from two separate verified domains, so
# that spam complaints on one cannot sink the other's reputation:
#
#   notify.pgkhata.com  bills, reminders, password resets  (this app)
#   mail.pgkhata.com    newsletters and announcements      (never from here)
#
# Both need their own SPF, DKIM and DMARC records in Resend. Bills and
# reminders must never go out on the marketing domain: if a campaign gets
# marked as spam, owners stop receiving the mail their business runs on.
RESEND_API_KEY=
RESEND_FROM_EMAIL=PGKhata <no-reply@notify.pgkhata.com>

# --- WhatsApp (official Meta Cloud API) ---
# From the Meta Business account, not a personal WhatsApp number. A self-hosted
# bridge driving a personal account breaks WhatsApp's terms and gets the number
# banned, so it is deliberately not supported.
#
# Reminders need a template named `rent_payment_reminder` approved in that
# account with five body parameters, submitted as:
#   Hi {{1}}, your rent for {{2}} at {{3}} is {{4}}. Due: {{5}}.
# Business-initiated messages outside a 24-hour service window must use an
# approved template; free-form text is rejected by Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Scheduled jobs ---
# Shared secret checked by the public hook routes. The pg_cron jobs read this
# from database settings, not from here:
#   ALTER DATABASE postgres SET app.cron_hook_secret = '<same value>';
CRON_HOOK_SECRET=
