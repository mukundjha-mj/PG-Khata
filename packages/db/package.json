{
  "name": "@pgkhata/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:check": "drizzle-kit check",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "drizzle-orm": "0.44.5",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "drizzle-kit": "0.31.4",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
